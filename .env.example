# Copy this file to .env and replace the placeholder with a local secret.
SECRET_KEY=replace-with-a-local-secret-key
# All runtime databases are ignored. Keep these three environments separate:
# mock: fixed by moveon.settings.a5_preview; no real Google credentials loaded.
# real local accounts: keep the original working database path if one exists.
# production: set DATABASE_PATH to its own persistent absolute path.
# New installation example (uncomment the following line to use):
# DATABASE_PATH=data/local.sqlite3
# If DATABASE_PATH is unset, the current default remains data/db.sqlite3.
# Selecting a working path does not create a backup; never overwrite an existing DB.
# Setup and backup details: docs/notes/week5_setup.md

# Optional Google OAuth web client credentials (environment only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ALLOWED_HOSTS=moveon.example.com

# Optional: powers AI Bundle Builder tier classification and listing image
# analysis. The Bundle Builder falls back to a heuristic when blank; image
# analysis is unavailable until this key is configured.
GEMINI_API_KEY=

# Optional Hugging Face token for the gated Llama 3.2 model.
# Accept the model license and grant access before first use.
HF_TOKEN=
# AI search reranks semantic matches with an LLM only when this is true.
# Development defaults to false (semantic search only, explained by a brief note).
# LOCAL_LLM_ENABLED=false

# LLM used for reranking when LOCAL_LLM_ENABLED=true.
# local (default): Llama-3.2-3B in-process; needs torch, HF_TOKEN, suitable hardware.
# groq: hosted openai/gpt-oss-20b via the Groq API; use on PythonAnywhere.
# Free tier: about 8K tokens/minute (~11 searches/minute); over that, search
# falls back to semantic matches.
# LLM_RANKING_BACKEND=groq
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Embeddings for listing search and pricing type suggestions.
# local (default): MiniLM via sentence-transformers and torch.
# gemini: hosted Gemini embeddings using GEMINI_API_KEY; use on PythonAnywhere,
# where torch does not fit. Restart the server after changing the backend.
# EMBEDDING_BACKEND=gemini
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Development prints readable email contents to the server console by default.
# For real delivery, configure an SMTP service in the deployment environment.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=MoveOn <no-reply@example.com>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
