# Copy this file to .env and replace the placeholder with a local secret.
SECRET_KEY=replace-with-a-local-secret-key

# Used by the AI Bundle Builder (bundles app) to classify Budget/Best Value/
# Premium bundle suggestions. Get a key at https://aistudio.google.com/apikey
# Optional: if left blank, the bundle builder automatically falls back to a
# plain price-based heuristic instead of failing.
GEMINI_API_KEY=
