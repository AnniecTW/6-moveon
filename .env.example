# Copy this file to .env and replace the placeholder with a local secret.
SECRET_KEY=replace-with-a-local-secret-key
# All runtime databases are ignored. Keep these three environments separate:
# mock: fixed by moveon.settings.a5_preview; no real Google credentials loaded.
# real local accounts: use the existing independent working database below.
# production: set DATABASE_PATH to its own persistent absolute path.
# DATABASE_PATH=data/backups/a5-local.sqlite3

# Optional Google OAuth web client credentials (environment only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ALLOWED_HOSTS=moveon.example.com

# Optional: powers the AI Bundle Builder's tier classification. Left blank,
# that feature falls back to a plain price-based heuristic instead of failing.
GEMINI_API_KEY=

# Development prints readable email contents to the server console by default.
# For real delivery, configure an SMTP service in the deployment environment.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=MoveOn <no-reply@example.com>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
